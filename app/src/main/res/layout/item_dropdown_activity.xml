<?xml version="1.0" encoding="utf-8"?>
<!-- item_dropdown_activity.xml: one row inside the activity dropdown list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Name on top, drain rate under it -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvActRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#059669"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Pencil: edit name and rate -->
    <ImageButton
        android:id="@+id/btnActEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Szerkesztés"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="#059669" />

    <!-- Bin: delete this activity -->
    <ImageButton
        android:id="@+id/btnActDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Törlés"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="#DC2626" />
</LinearLayout>