<?xml version="1.0" encoding="utf-8"?>
<!-- item_tevekenyseg.xml: one row of the added-activities list -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#ECFDF5"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#A7F3D0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <!-- Filled from Java: name - hours (rate) -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Tevékenység neve - 0 óra (0%/óra)"
            android:textColor="#064E3B"
            android:textSize="15sp" />

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Törlés"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#DC2626" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>